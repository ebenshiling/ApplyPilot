# ApplyPilot Environment Configuration
# Copy to ~/.applypilot/.env and fill in your values.

# LLM Provider (pick one)
GEMINI_API_KEY=           # Gemini 2.0 Flash (recommended, cheapest)
# OPENAI_API_KEY=         # OpenAI API key
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-6-luna    # Also supports gpt-5.6-luna and older GPT-4 models
# OPENAI_REASONING_EFFORT=none # Luna: none, low, medium, high, xhigh, max
# Optional per-task routing (unconfigured tasks inherit LLM_PROVIDER / LLM_MODEL).
# LLM_SCORE_PROVIDER=gemini
# LLM_SCORE_MODEL=gemini-2.5-flash
# LLM_SCORE_THINKING_BUDGET=0
# LLM_SUMMARY_PROVIDER=gemini
# LLM_SUMMARY_MODEL=gemini-2.5-flash
# LLM_SUMMARY_THINKING_BUDGET=0
# LLM_TAILOR_PROVIDER=openai
# LLM_TAILOR_MODEL=gpt-6-luna
# LLM_TAILOR_REASONING_EFFORT=none
# LLM_TAILOR_REASONING_TOKEN_ALLOWANCE=2048 # Optional combined-token headroom with low reasoning
# LLM_STATEMENT_PROVIDER=openai
# LLM_STATEMENT_MODEL=gpt-6-luna
# LLM_STATEMENT_REASONING_EFFORT=none
# LLM_STATEMENT_REASONING_TOKEN_ALLOWANCE=2048
# LLM_COVER_PROVIDER=openai
# LLM_COVER_MODEL=gpt-6-luna
# LLM_COVER_REASONING_TOKEN_ALLOWANCE=2048
# LLM_REVIEW_PROVIDER=openai
# LLM_REVIEW_MODEL=gpt-4.1-mini
# LLM_EMAIL_PROVIDER=openai
# LLM_EMAIL_MODEL=gpt-6-luna
# LLM_EMAIL_REASONING_EFFORT=none
# The same suffixes work for ASSISTANT, FORMS and EXTRACT.
# ANTHROPIC_API_KEY=      # Direct Claude API (separate from Claude Code login)
# LLM_PROVIDER=anthropic # gemini, openai, anthropic, or local
# LLM_MODEL=claude-sonnet-4-6
# APPLYPILOT_AI_DAILY_REQUESTS=50 # Command-center assistant request budget per workspace
# APPLYPILOT_DECISIONS_OBSERVER=0 # Optional observation-only Luna page classifier
# APPLYPILOT_DECISIONS_DAILY_BUDGET=20 # Counts toward the workspace AI request budget
# APPLYPILOT_SCHEDULE_DAILY_LIMIT=20
# APPLYPILOT_RECONCILE_STALE=1 # Hold interrupted CLI applications for review

# Optional mailbox integrations. Register the exact callback URL with each provider.
# APPLYPILOT_OAUTH_REDIRECT_BASE=http://127.0.0.1:8765
# Callback: http://127.0.0.1:8765/api/center/mail/callback
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# OUTLOOK_CLIENT_ID=
# OUTLOOK_CLIENT_SECRET=
# LLM_URL=http://127.0.0.1:8080/v1  # Local LLM (llama.cpp, Ollama)
# LLM_MODEL=              # Override model name

# Auto-Apply (optional)
CAPSOLVER_API_KEY=        # For CAPTCHA solving during auto-apply

# Proxy (optional, for scraping)
# PROXY=host:port:user:pass
